<?xml version="1.0" encoding="utf-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource PageBackground}" TextElement.Foreground="{DynamicResource TextPrimary}" TextElement.FontSize="14">
  <Grid.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033" />
    <SolidColorBrush x:Key="Muted" Color="#5F6D82" />
    <SolidColorBrush x:Key="Line" Color="#E3E9F2" />
    <SolidColorBrush x:Key="PageBackground" Color="#F3F6FA" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F5F8FC" />
    <SolidColorBrush x:Key="Border" Color="#D6DFEB" />
    <SolidColorBrush x:Key="TextPrimary" Color="#172033" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5F6D82" />
    <SolidColorBrush x:Key="TextTertiary" Color="#75839A" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentForeground" Color="#2465D5" />
    <SolidColorBrush x:Key="AccentSurface" Color="#EAF1FF" />
    <SolidColorBrush x:Key="InfoText" Color="#355B94" />
    <SolidColorBrush x:Key="HoverSurface" Color="#F1F5FC" />
    <SolidColorBrush x:Key="SelectionSurface" Color="#EAF1FF" />
    <SolidColorBrush x:Key="Success" Color="#147D55" />
    <SolidColorBrush x:Key="SuccessSurface" Color="#E8F7EF" />
    <SolidColorBrush x:Key="Danger" Color="#B73535" />
    <SolidColorBrush x:Key="DangerSurface" Color="#FFF0EF" />
    <SolidColorBrush x:Key="Warning" Color="#936619" />
    <SolidColorBrush x:Key="WarningSurface" Color="#FFF5DB" />
    <SolidColorBrush x:Key="NeutralSurface" Color="#E9EEF5" />
    <SolidColorBrush x:Key="Focus" Color="#3478F6" />
    <SolidColorBrush x:Key="Track" Color="#F3F6FA" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#B5C1D2" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#8390A5" />
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.66" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style x:Key="Nav" TargetType="ToggleButton">
      <Setter Property="Height" Value="46" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="NavBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter Margin="14,0" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource HoverSurface}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SelectionSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="SelectionMode" Value="Extended" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="RowHeight" Value="42" />
      <Setter Property="ColumnHeaderHeight" Value="40" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAlt}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverSurface}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="SelectionOpacity" Value="0.3" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="EditorBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="EditorBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollHandle" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource ScrollThumb}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" /></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource Track}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollHandle}" /></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" /></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                <Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="12" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionSurface}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                      <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="10,4,28,4" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="None">
                <Border x:Name="PopupSurface" Background="{DynamicResource Surface}" TextElement.Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="280" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GridComboDisplay" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="GridComboEditor" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
    <Style x:Key="GridText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="GridEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="4,5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="216" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
    <Grid Margin="20,28,20,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Border Background="{DynamicResource Focus}" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left">
          <Viewbox Width="25" Height="25">
            <Canvas Width="24" Height="24">
              <Path Fill="{DynamicResource AccentText}" Data="M2,4 L8,4 L8,10 L2,10 Z M10,4 L16,4 L16,10 L10,10 Z M18,4 L22,4 L22,20 L18,20 Z M2,12 L8,12 L8,20 L2,20 Z M10,12 L16,12 L16,20 L10,20 Z" />
            </Canvas>
          </Viewbox>
        </Border>
        <TextBlock Text="Steam 自动优选" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBlock Text="更顺畅的游戏下载" Style="{StaticResource Caption}" />
      </StackPanel>
      <StackPanel Grid.Row="2">
        <ToggleButton x:Name="NavOverview" Style="{StaticResource Nav}" AutomationProperties.Name="下载概览">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="▦" FontSize="20" Width="30" VerticalAlignment="Center" />
            <TextBlock Text="下载概览" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="NavDomains" Style="{StaticResource Nav}" AutomationProperties.Name="域名规则">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="↗" FontSize="20" Width="30" VerticalAlignment="Center" />
            <TextBlock Text="域名规则" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="NavLogs" Style="{StaticResource Nav}" AutomationProperties.Name="运行记录">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="≡" FontSize="22" Width="30" VerticalAlignment="Center" />
            <TextBlock Text="运行记录" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="NavHelp" Style="{StaticResource Nav}" AutomationProperties.Name="使用帮助">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="?" FontSize="20" Width="30" VerticalAlignment="Center" />
            <TextBlock Text="使用帮助" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
      </StackPanel>
      <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="14">
        <StackPanel>
          <TextBlock Text="本机转发组件" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Ellipse x:Name="SidebarDot" Width="7" Height="7" Fill="{DynamicResource TextTertiary}" Margin="0,0,7,0" />
            <TextBlock x:Name="SidebarState" Text="已停止" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="PageTitle" Text="下载概览" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="PageDescription" Text="自动检测可用节点，让每次下载更顺畅。" Foreground="{DynamicResource TextSecondary}" Margin="0,8,16,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,8,0,0">
        <ComboBox x:Name="ThemeMode" Width="116" Height="40" Margin="0,0,12,0" SelectedIndex="0" ToolTip="外观主题" AutomationProperties.Name="外观主题">
          <ComboBoxItem Content="跟随系统" Tag="system" />
          <ComboBoxItem Content="浅色模式" Tag="light" />
          <ComboBoxItem Content="深色模式" Tag="dark" />
        </ComboBox>
        <Border x:Name="StateBadge" Background="{DynamicResource NeutralSurface}" CornerRadius="16" Padding="12,7" Margin="0,3,12,0" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{DynamicResource TextTertiary}" Margin="0,0,7,0" />
            <TextBlock x:Name="StateText" Text="已停止" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
          </StackPanel>
        </Border>
        <Button x:Name="StartButton" Content="启动优选" Style="{StaticResource Primary}" Width="112" AutomationProperties.Name="启动优选" />
        <Button x:Name="StopButton" Content="停止优选" Style="{StaticResource Action}" Width="112" Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.Name="停止优选" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
      <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="24">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="实际下行速度" Foreground="{DynamicResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                  <TextBlock x:Name="SpeedValue" Text="0" FontSize="60" FontWeight="SemiBold" Foreground="{DynamicResource AccentForeground}" TextWrapping="NoWrap" />
                  <TextBlock x:Name="SpeedUnit" Text="B/s" FontSize="20" Foreground="{DynamicResource TextTertiary}" Margin="12,0,0,10" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock x:Name="SpeedDescription" Text="启动优选后，开始 Steam 下载即可。" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource HoverSurface}" CornerRadius="12" Padding="20" Margin="24,0,0,0" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="自动检测 · 持续优选" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentForeground}" />
                  <TextBlock Text="下载时验证当前来源的节点，地址变化或持续变慢后重新检测。" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,0" LineHeight="21" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <UniformGrid Columns="3" Margin="0,16,0,16">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="当前下载来源" Style="{StaticResource Caption}" />
                <TextBlock x:Name="CurrentSource" Text="等待下载" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="CurrentSourceDetail" Text="跟随 Steam 的下载来源" Style="{StaticResource Caption}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="4,0,4,0">
              <StackPanel>
                <TextBlock Text="优先使用的节点" Style="{StaticResource Caption}" />
                <TextBlock x:Name="PreferredCount" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,8" />
                <TextBlock Text="从已验证地址中自动选择" Style="{StaticResource Caption}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Text="本次转发数据" Style="{StaticResource Caption}" />
                <TextBlock x:Name="TransferredValue" Text="0 B" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,8" />
                <TextBlock x:Name="ProbeTraffic" Text="检测流量 0 B" Style="{StaticResource Caption}" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="20,18,20,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="下载节点" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="查看传输速度与最近一次节点采样" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <ComboBox x:Name="NodeFilter" Width="110" Height="36" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="节点筛选">
                    <ComboBoxItem Content="全部节点" />
                    <ComboBoxItem Content="优先使用" />
                  </ComboBox>
                  <Button x:Name="CopyIpButton" Content="复制 IP" Style="{StaticResource Action}" Height="36" IsEnabled="False" />
                </StackPanel>
              </Grid>
              <Grid Height="240">
                <DataGrid x:Name="NodesGrid" IsReadOnly="True" AutomationProperties.Name="下载节点列表">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="120" ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="IP 地址" Binding="{Binding IP}" Width="*" MinWidth="210" ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="实际下行" Binding="{Binding Rate}" Width="116" ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="实测速度" Binding="{Binding Score}" Width="116" ElementStyle="{StaticResource GridText}" />
                    <DataGridTemplateColumn Header="状态" Width="112">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border Background="{Binding StatusBackground}" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding State}" Foreground="{Binding StatusForeground}" FontSize="12" TextWrapping="NoWrap" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="NodesEmpty" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,56,24,0" IsHitTestVisible="False">
                  <TextBlock Text="等待下载节点" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Text="Steam 开始下载后，会在这里显示候选地址与检测结果。" FontSize="13" Foreground="{DynamicResource TextTertiary}" Margin="0,10,0,0" TextAlignment="Center" />
                </StackPanel>
              </Grid>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                <TextBlock Text="节点采样会产生少量额外流量；实际下载速度受线路、CDN 和磁盘影响。" Style="{StaticResource Caption}" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="DomainsPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SelectionSurface}" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
          <TextBlock Text="只填写 Steam 的 HTTP 下载域名，并选择它原本对应的 CDN 来源。保存后自动更新本机转发规则。" Foreground="{DynamicResource InfoText}" FontSize="13" LineHeight="21" />
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="224" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="18,18,18,16" Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="下载域名" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="DomainCount" Text="正在读取规则…" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="AddDomainButton" Content="添加" Style="{StaticResource Action}" Width="64" Margin="0,0,8,0" AutomationProperties.Name="添加域名" />
                  <Button x:Name="DeleteDomainButton" Content="删除" Style="{StaticResource Action}" Width="64" AutomationProperties.Name="删除选中域名" />
                </StackPanel>
              </Grid>
              <DataGrid x:Name="DomainsGrid" AutomationProperties.Name="域名规则表" Grid.Row="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="域名" Binding="{Binding domain, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="180" ElementStyle="{StaticResource GridText}" EditingElementStyle="{StaticResource GridEditor}" />
                  <DataGridComboBoxColumn x:Name="SourceColumn" Header="CDN 来源" SelectedValueBinding="{Binding groupId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="id" DisplayMemberPath="name" Width="132" ElementStyle="{StaticResource GridComboDisplay}" EditingElementStyle="{StaticResource GridComboEditor}" />
                  <DataGridComboBoxColumn x:Name="KindColumn" Header="用途" SelectedValueBinding="{Binding kind, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="110" ElementStyle="{StaticResource GridComboDisplay}" EditingElementStyle="{StaticResource GridComboEditor}" />
                </DataGrid.Columns>
              </DataGrid>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18" Grid.Row="2">
                <StackPanel>
                  <TextBlock x:Name="DomainFeedback" Text="更改后点击“保存并应用”，转发服务会短暂重启。" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="21" MinHeight="42" Margin="0,0,0,12" />
                  <WrapPanel>
                    <Button x:Name="DefaultDomainsButton" Content="恢复默认" Style="{StaticResource Action}" Margin="0,0,8,8" />
                    <Button x:Name="ReloadDomainsButton" Content="取消更改" Style="{StaticResource Action}" Margin="0,0,8,8" />
                    <Button x:Name="ApplyDomainsButton" Content="保存并应用" Style="{StaticResource Primary}" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                  <TextBlock Text="请求如何转发" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />
                  <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12">
                    <TextBlock Text="Steam 下载请求" TextAlignment="Center" FontSize="13" />
                  </Border>
                  <TextBlock Text="↓" TextAlignment="Center" Foreground="{DynamicResource TextTertiary}" Margin="0,6" />
                  <Border Background="{DynamicResource SelectionSurface}" CornerRadius="8" Padding="12">
                    <StackPanel>
                      <TextBlock Text="本机自动优选" TextAlignment="Center" Foreground="{DynamicResource AccentForeground}" FontSize="13" />
                      <TextBlock Text="127.0.0.19" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="↓" TextAlignment="Center" Foreground="{DynamicResource TextTertiary}" Margin="0,6" />
                  <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12">
                    <TextBlock Text="所选来源的 CDN 节点" TextAlignment="Center" FontSize="13" />
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="两种用途" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="下载地址" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,6" />
                  <TextBlock Text="保留原域名、文件路径和授权，向该来源的节点请求数据。" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="20" />
                  <TextBlock Text="跳转入口" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,6" />
                  <TextBlock Text="将请求跳转到所选来源的下载地址。已有入口规则会保留原目标。" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="20" />
                  <TextBlock Text="删除域名后，该域名恢复正常解析。" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,16,0,0" LineHeight="20" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Border x:Name="LogsPage" Visibility="Collapsed" Style="{StaticResource Card}" Padding="24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="服务与节点事件" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="显示最近的启动、来源变化、节点检测与恢复记录。" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" FontSize="13" />
          </StackPanel>
          <Grid Grid.Row="2">
            <ListBox x:Name="LogsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,0,4" />
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextTertiary}" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource TextPrimary}" LineHeight="21" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="LogsEmpty" Text="暂无运行记录" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
      <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="28">
            <StackPanel>
              <TextBlock Text="开始一次下载" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="01   点击右上角“启动优选”。" Margin="0,22,0,0" />
              <TextBlock Text="02   在 Steam 中开始下载或更新游戏。" Margin="0,14,0,0" />
              <TextBlock Text="03   在“下载概览”查看来源、节点和实际速度。" Margin="0,14,0,0" />
              <TextBlock Text="工具接到真实下载请求后，才会检测当前来源的候选节点。换游戏、地址池变化或持续变慢时，会重新验证。" Foreground="{DynamicResource TextSecondary}" Margin="0,22,0,0" LineHeight="24" />
            </StackPanel>
          </Border>
          <UniformGrid Columns="2" Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="停止与关闭" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="停止优选" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Text="停止转发并恢复原设置，窗口保持打开，可再次启动。" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="22" />
                <TextBlock Text="关闭窗口" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Text="自动停止并等待恢复完成，然后退出程序。" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="22" />
                <TextBlock Text="最小化" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Text="收起到系统托盘继续运行，双击图标可打开窗口。" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="22" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24" Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Text="支持范围" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Steam HTTP 下载" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Text="优选当前下载来源内的节点；域名规则需要匹配该来源。其他平台和 HTTPS 下载需要对应的协议适配。" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="22" />
                <TextBlock Text="对战与带宽" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Text="CS 对战连接不经过此工具。边下载边玩可能占满宽带，影响延迟，可先暂停下载。" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="22" />
                <TextBlock Text="与原助手配合" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Text="本工具运行时，无需再启动原助手的 Steam 服务。" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="22" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border x:Name="MessageBar" Grid.Row="3" CornerRadius="8" Background="Transparent" Padding="4,14,4,0">
      <TextBlock x:Name="RuntimeMessage" Text="准备就绪" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </Border>
  </Grid>
</Grid>
